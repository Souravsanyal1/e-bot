# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Numeric IDs for Admins (comma-separated). Set your Telegram ID here to access Admin panel!
ADMIN_IDS=111111111,222222222,999888777

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Database URL (PostgreSQL for Production on Render/Railway/VPS). Leave blank for embedded SQLite mode!
DATABASE_URL=postgresql://user:password@localhost:5432/eforce

# Redis URL (e.g. Upstash or Redis on VPS). Leave blank for in-memory cache!
REDIS_URL=redis://default:password@localhost:6379

# Telegram Mini App Short URL / Web App URL
MINI_APP_URL=https://t.me/your_bot_username/app

# Adsgram Block ID for video/reward ads
ADSGRAM_BLOCK_ID=int-9999

# 24H Mining Engine Settings
BASE_MINING_RATE=0.5
SESSION_DURATION_HOURS=24
REFERRAL_SPEED_BOOST=0.05
REFERRAL_COIN_BONUS=10.0
