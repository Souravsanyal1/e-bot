{
  "name": "eforce-miniapp-stack",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"node --watch backend/server.js\" \"npm run dev --prefix frontend\"",
    "start": "node backend/server.js",
    "backend": "node backend/server.js",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "bot": "node backend/bot.js"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "grammy": "^1.26.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "better-sqlite3": "^11.3.0",
    "concurrently": "^8.2.2"
  }
}
